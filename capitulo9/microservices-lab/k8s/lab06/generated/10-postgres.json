{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-data",
        "namespace": "microservices"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "microservices"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16.3-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "lab_admin"
                  },
                  {
                    "name": "POSTGRES_DB",
                    "value": "eventstore_db"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "POSTGRES_PASSWORD"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "lab_admin",
                      "-d",
                      "eventstore_db"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 5,
                  "failureThreshold": 60
                },
                "volumeMounts": [
                  {
                    "name": "volume-0",
                    "mountPath": "/var/lib/postgresql/data",
                    "readOnly": false
                  },
                  {
                    "name": "volume-1",
                    "mountPath": "/docker-entrypoint-initdb.d",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "volume-0",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data"
                }
              },
              {
                "name": "volume-1",
                "configMap": {
                  "name": "postgres-init"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "microservices"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "postgres"
        },
        "ports": [
          {
            "name": "tcp-5432",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    }
  ]
}