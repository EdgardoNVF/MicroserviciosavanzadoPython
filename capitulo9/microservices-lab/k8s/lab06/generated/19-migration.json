{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "eventstore-migrate",
        "namespace": "microservices"
      },
      "spec": {
        "backoffLimit": 1,
        "activeDeadlineSeconds": 180,
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "enableServiceLinks": false,
            "containers": [
              {
                "name": "migration",
                "image": "order-service:lab06",
                "imagePullPolicy": "Never",
                "command": [
                  "python",
                  "-m",
                  "alembic",
                  "upgrade",
                  "head"
                ],
                "env": [
                  {
                    "name": "EVENTSTORE_ADMIN_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "EVENTSTORE_ADMIN_DATABASE_URL"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}