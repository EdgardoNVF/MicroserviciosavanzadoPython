{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "order-service",
        "namespace": "microservices"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "order-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "order-service"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "containers": [
              {
                "name": "order-service",
                "image": "order-service:lab06",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "containerPort": 8001
                  }
                ],
                "env": [
                  {
                    "name": "AUTH_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "AUTH_ISSUER",
                    "value": "http://localhost:8080/realms/microservices-lab"
                  },
                  {
                    "name": "AUTH_JWKS_URL",
                    "value": "http://keycloak:8080/realms/microservices-lab/protocol/openid-connect/certs"
                  },
                  {
                    "name": "EVENTSTORE_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "MESSAGING_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "KAFKA_BOOTSTRAP_SERVERS",
                    "value": "kafka:9092"
                  },
                  {
                    "name": "RESILIENCE_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "INVENTORY_BASE_URL",
                    "value": "http://inventory-service:8002"
                  },
                  {
                    "name": "RESILIENCE_REDIS_URL",
                    "value": "redis://redis:6379/1"
                  },
                  {
                    "name": "RESILIENCE_NAMESPACE",
                    "value": "lab06:orders:normal:inventory"
                  },
                  {
                    "name": "RESILIENCE_FAIL_MAX",
                    "value": "5"
                  },
                  {
                    "name": "RESILIENCE_RESET_TIMEOUT",
                    "value": "30"
                  },
                  {
                    "name": "RESILIENCE_MAX_CONCURRENT",
                    "value": "10"
                  },
                  {
                    "name": "AUTH_TOKEN_URL",
                    "value": "http://keycloak:8080/realms/microservices-lab/protocol/openid-connect/token"
                  },
                  {
                    "name": "EVENTSTORE_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "EVENTSTORE_DATABASE_URL"
                      }
                    }
                  },
                  {
                    "name": "EVENTSTORE_ADMIN_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "EVENTSTORE_ADMIN_KEY"
                      }
                    }
                  },
                  {
                    "name": "ORDER_SERVICE_CLIENT_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "ORDER_SERVICE_CLIENT_ID"
                      }
                    }
                  },
                  {
                    "name": "ORDER_SERVICE_CLIENT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "lab-credentials",
                        "key": "ORDER_SERVICE_CLIENT_SECRET"
                      }
                    }
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8001
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "order-service",
        "namespace": "microservices"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "order-service"
        },
        "ports": [
          {
            "name": "tcp-8001",
            "port": 8001,
            "targetPort": 8001
          }
        ]
      }
    }
  ]
}
