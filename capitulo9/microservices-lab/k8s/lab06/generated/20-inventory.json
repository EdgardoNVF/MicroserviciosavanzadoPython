{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "inventory-service",
        "namespace": "microservices"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "inventory-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "inventory-service"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "containers": [
              {
                "name": "inventory-service",
                "image": "inventory-service:lab06",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "containerPort": 8002
                  }
                ],
                "env": [
                  {
                    "name": "AUTH_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "AUTH_ISSUER",
                    "value": "http://localhost:8080/realms/microservices-lab"
                  },
                  {
                    "name": "AUTH_JWKS_URL",
                    "value": "http://keycloak:8080/realms/microservices-lab/protocol/openid-connect/certs"
                  },
                  {
                    "name": "MESSAGING_ENABLED",
                    "value": "true"
                  },
                  {
                    "name": "KAFKA_BOOTSTRAP_SERVERS",
                    "value": "kafka:9092"
                  },
                  {
                    "name": "REDIS_URL",
                    "value": "redis://redis:6379/0"
                  },
                  {
                    "name": "LAB_GATEWAY_TESTS_ENABLED",
                    "value": "true"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8002
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "inventory-service",
        "namespace": "microservices"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "inventory-service"
        },
        "ports": [
          {
            "name": "tcp-8002",
            "port": 8002,
            "targetPort": 8002
          }
        ]
      }
    }
  ]
}